# 講師配布のAzure Database for MySQL Flexible Serverの接続情報をここに設定する。
# 例: mysql+pymysql://<user>:<password>@<host>:3306/<database>?ssl_ca=...
# Azure MySQL Flexible ServerはTLS必須のことが多いので、証明書が必要な場合はssl_caを付ける。
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/pos_lv2

# 認証チェックのON/OFF。security.py の TODO 4か所を書き終えるまでは true のまま
# （true の間はトークン無しでもAPIが動く）。書き終えたら false にする。
DISABLE_AUTH=true
